# Example environment variables for the backend
# Normally, this file is NOT needed in production since env vars are set in the deployment
# during development, the default values should work fine.

# Copy this file to .env and customize the values as needed
# Do NOT commit your actual .env file with real secrets to version control

# These should match the MySQL settings in docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=minimal_app_db
FRONTEND_ORIGIN=http://localhost:5173

# Team 5 — scraper service (mock Amazon / BestBuy / Walmart reviews)
# Local: http://localhost:5000   |   Docker Compose: http://scraper:5000 (set in docker-compose.yml)
SCRAPER_URL=http://localhost:5000
SCRAPER_TIMEOUT_MS=8000
# Minimum delay between two fetches of the same product (rate-limit protection)
FETCH_COOLDOWN_MS=5000
